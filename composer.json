{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.0.1",
    "intervention/image": "^2.5",
    "laravel/framework": "^12.0",
    "nesbot/carbon": "^3.0",
    "laravel/tinker": "^2.5",
    "laravel/ui": "^4.0",
    "rats/zkteco": "^002.0",
    "riskihajar/terbilang": "^1.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "laravel/sail": "^1.0.1",
    "laravel/telescope": "^5.0",
    "mockery/mockery": "^1.4.2",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/Helper.php",
      "app/Helpers/ActivityLog.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "setup": [
      "composer install",
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "php artisan key:generate --ansi",
      "php -r \"$storageExists = is_dir('public/storage'); if ($storageExists) { array_map('unlink', glob('public/storage/*')); rmdir('public/storage'); echo 'Storage directory deleted successfully.'; } else { echo 'Storage directory does not exist.'; }\"",
      "php artisan storage:link --ansi",
      "php artisan migrate:fresh --seed --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "policy": {
      "advisories": {
        "ignore-id": [
          "PKSA-b41t-wbzk-9q51",
          "PKSA-d5tc-s1qs-h781",
          "PKSA-m5cs-t1y6-qpcs",
          "PKSA-3r5d-mb8f-1qw9",
          "PKSA-mdq4-51ck-6kdq",
          "PKSA-8qx3-n5y5-vvnd",
          "PKSA-w7xr-vk7n-rstm"
        ]
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
